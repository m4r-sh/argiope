      "name": "meta.embedded.argiope.html",
      "contentName": "text.html.basic",
      "begin": "(?<![\\w$.])(html)(\\s*)(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.argiope.html"
        },
        "3": {
          "name": "punctuation.definition.string.begin.argiope"
        }
      },
      "end": "(?<!\\\\)(?:\\\\\\\\)*`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.argiope"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.argiope",
          "match": "\\\\(?:`|\\$\\{)"
        },
        {
          "name": "meta.interpolation.argiope",
          "begin": "(?<!\\\\)(?:\\\\\\\\)*(\\$\\{)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.interpolation.begin.argiope"
            }
          },
          "end": "(})",
          "endCaptures": {
            "1": {
              "name": "punctuation.section.interpolation.end.argiope"
            }
          },
          "patterns": [
            {
              "include": "source.ts"
            },
            {
              "begin": "\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.argiope"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.argiope"
                }
              },
              "patterns": [
                {
                  "include": "source.ts"
