    "test": "bun test"
  },
  "dependencies": {
    "@m4rsh/cones": "^1.2.1",
    "culori": "4.0.2",
    "cusphanger": "0.3.0",
    "nutelch": "0.2.0",
    "orbz": "file:../../ztack/orbz"
  }
}
